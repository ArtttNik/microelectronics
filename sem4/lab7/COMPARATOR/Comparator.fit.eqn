--A1L71 is LessThan~286 at LC_X1_Y1_N9
--operation mode is normal

A1L71 = B[3] & !B[2] & A[2] & A[3] # !B[3] & (A[3] # !B[2] & A[2]);


--A1L81 is LessThan~287 at LC_X1_Y1_N4
--operation mode is normal

A1L81 = B[1] & !B[0] & A[0] & A[1] # !B[1] & (A[1] # !B[0] & A[0]);


--A1L91 is LessThan~288 at LC_X1_Y1_N2
--operation mode is normal

A1L91 = B[2] & A[2] & (B[3] $ !A[3]) # !B[2] & !A[2] & (B[3] $ !A[3]);


--A1L02 is LessThan~289 at LC_X1_Y1_N8
--operation mode is normal

A1L02 = A1L71 # A1L81 & (A1L91);


--A1L7 is A_equal_B~20 at LC_X1_Y1_N5
--operation mode is normal

A1L7 = B[1] & A[1] & (B[0] $ !A[0]) # !B[1] & !A[1] & (B[0] $ !A[0]);


--A1L8 is A_equal_B~21 at LC_X1_Y1_N6
--operation mode is normal

A1L8 = A1L81 # A1L71 # !A1L91 # !A1L7;


--A1L11 is A_less_B~30 at LC_X1_Y1_N7
--operation mode is normal

A1L11 = !A1L71 & (!A1L81 & !A1L7 # !A1L91);


--A[3] is A[3] at PIN_Y21
--operation mode is input

A[3] = INPUT();


--A[2] is A[2] at PIN_U19
--operation mode is input

A[2] = INPUT();


--B[2] is B[2] at PIN_U20
--operation mode is input

B[2] = INPUT();


--B[3] is B[3] at PIN_AA21
--operation mode is input

B[3] = INPUT();


--A[1] is A[1] at PIN_Y20
--operation mode is input

A[1] = INPUT();


--A[0] is A[0] at PIN_W19
--operation mode is input

A[0] = INPUT();


--B[0] is B[0] at PIN_T18
--operation mode is input

B[0] = INPUT();


--B[1] is B[1] at PIN_W20
--operation mode is input

B[1] = INPUT();


--A_greater_B is A_greater_B at PIN_W22
--operation mode is output

A_greater_B = OUTPUT(A1L02);


--A_equal_B is A_equal_B at PIN_AA20
--operation mode is output

A_equal_B = OUTPUT(!A1L8);


--A_less_B is A_less_B at PIN_W21
--operation mode is output

A_less_B = OUTPUT(A1L11);



