--A1L71 is LessThan~286
--operation mode is normal

A1L71 = A[3] & (A[2] & !B[2] # !B[3]) # !A[3] & A[2] & !B[2] & !B[3];


--A1L81 is LessThan~287
--operation mode is normal

A1L81 = A[1] & (A[0] & !B[0] # !B[1]) # !A[1] & A[0] & !B[0] & !B[1];


--A1L91 is LessThan~288
--operation mode is normal

A1L91 = B[3] & A[3] & (A[2] $ !B[2]) # !B[3] & !A[3] & (A[2] $ !B[2]);


--A1L02 is LessThan~289
--operation mode is normal

A1L02 = A1L71 # A1L81 & A1L91;


--A1L7 is A_equal_B~20
--operation mode is normal

A1L7 = B[1] & A[1] & (A[0] $ !B[0]) # !B[1] & !A[1] & (A[0] $ !B[0]);


--A1L8 is A_equal_B~21
--operation mode is normal

A1L8 = A1L81 # A1L71 # !A1L7 # !A1L91;


--A1L11 is A_less_B~30
--operation mode is normal

A1L11 = !A1L71 & (!A1L81 & !A1L7 # !A1L91);


--A[3] is A[3]
--operation mode is input

A[3] = INPUT();


--A[2] is A[2]
--operation mode is input

A[2] = INPUT();


--B[2] is B[2]
--operation mode is input

B[2] = INPUT();


--B[3] is B[3]
--operation mode is input

B[3] = INPUT();


--A[1] is A[1]
--operation mode is input

A[1] = INPUT();


--A[0] is A[0]
--operation mode is input

A[0] = INPUT();


--B[0] is B[0]
--operation mode is input

B[0] = INPUT();


--B[1] is B[1]
--operation mode is input

B[1] = INPUT();


--A_greater_B is A_greater_B
--operation mode is output

A_greater_B = OUTPUT(A1L02);


--A_equal_B is A_equal_B
--operation mode is output

A_equal_B = OUTPUT(!A1L8);


--A_less_B is A_less_B
--operation mode is output

A_less_B = OUTPUT(A1L11);


