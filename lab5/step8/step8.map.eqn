--t1 is t1
--operation mode is normal

t1_lut_out = !t1;
t1 = DFFEAS(t1_lut_out, c, r, , jk, , , , );


--t2 is t2
--operation mode is normal

t2_lut_out = !t2;
t2 = DFFEAS(t2_lut_out, c, r, , A1L01, , , , );


--t3 is t3
--operation mode is normal

t3_lut_out = !t3;
t3 = DFFEAS(t3_lut_out, c, r, , A1L41, , , , );


--t4 is t4
--operation mode is normal

t4_lut_out = !t4;
t4 = DFFEAS(t4_lut_out, c, r, , A1L31, , , , );


--A1L01 is t2~12
--operation mode is normal

A1L01 = t1 & jk;


--A1L41 is t4~12
--operation mode is normal

A1L41 = t1 & t2 & jk;


--A1L31 is t4~0
--operation mode is normal

A1L31 = t1 & t2 & t3 & jk;


--c is c
--operation mode is input

c = INPUT();


--r is r
--operation mode is input

r = INPUT();


--jk is jk
--operation mode is input

jk = INPUT();


--q1 is q1
--operation mode is output

q1 = OUTPUT(t1);


--q2 is q2
--operation mode is output

q2 = OUTPUT(t2);


--q3 is q3
--operation mode is output

q3 = OUTPUT(t3);


--q4 is q4
--operation mode is output

q4 = OUTPUT(t4);


