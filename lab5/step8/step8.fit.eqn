--t1 is t1 at LC_X2_Y29_N8
--operation mode is normal

t1_lut_out = !t1;
t1 = DFFEAS(t1_lut_out, GLOBAL(c), GLOBAL(r), , jk, , , , );


--t2 is t2 at LC_X2_Y29_N2
--operation mode is normal

t2_lut_out = !t2;
t2 = DFFEAS(t2_lut_out, GLOBAL(c), GLOBAL(r), , A1L01, , , , );


--t3 is t3 at LC_X1_Y29_N2
--operation mode is normal

t3_lut_out = !t3;
t3 = DFFEAS(t3_lut_out, GLOBAL(c), GLOBAL(r), , A1L41, , , , );


--t4 is t4 at LC_X3_Y29_N2
--operation mode is normal

t4_lut_out = !t4;
t4 = DFFEAS(t4_lut_out, GLOBAL(c), GLOBAL(r), , A1L31, , , , );


--A1L01 is t2~12 at LC_X2_Y29_N6
--operation mode is normal

A1L01 = jk & t1;


--A1L41 is t4~12 at LC_X2_Y29_N5
--operation mode is normal

A1L41 = t2 & (jk & t1);


--A1L31 is t4~0 at LC_X2_Y29_N4
--operation mode is normal

A1L31 = t2 & t3 & jk & t1;


--c is c at PIN_L2
--operation mode is input

c = INPUT();


--r is r at PIN_L3
--operation mode is input

r = INPUT();


--jk is jk at PIN_E22
--operation mode is input

jk = INPUT();


--q1 is q1 at PIN_C21
--operation mode is output

q1 = OUTPUT(t1);


--q2 is q2 at PIN_E21
--operation mode is output

q2 = OUTPUT(t2);


--q3 is q3 at PIN_F18
--operation mode is output

q3 = OUTPUT(t3);


--q4 is q4 at PIN_A19
--operation mode is output

q4 = OUTPUT(t4);



